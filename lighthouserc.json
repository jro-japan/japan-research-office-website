{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "http://localhost/",
        "http://localhost/services.html",
        "http://localhost/pricing.html",
        "http://localhost/research-products.html",
        "http://localhost/research-library.html",
        "http://localhost/contact.html",
        "http://localhost/ja/",
        "http://localhost/trust-center.html",
        "http://localhost/ordering-payment.html",
        "http://localhost/sample-tender-evidence.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
